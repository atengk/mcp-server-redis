# ==============================================================================
# atengk-mcp-server-redis 环境变量配置模板
# 复制此文件为 .env 即可开箱即用: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Redis 连接串配置 (Connection URL)
# 优先级最高。格式支持:
# - 单机免密: redis://localhost:6379/0
# - 单机带密: redis://:your_password@localhost:6379/0
# - SSL/TLS: rediss://:your_password@localhost:6380/0
# - Cluster 集群: redis-cluster://127.0.0.1:7000/0 或 rediss-cluster://...
# ------------------------------------------------------------------------------
MCP_REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 2. 离散连接参数 (当未配置 MCP_REDIS_URL 时自动拼装生效)
# ------------------------------------------------------------------------------
# MCP_REDIS_HOST=localhost
# MCP_REDIS_PORT=6379
# MCP_REDIS_PASSWORD=
# MCP_REDIS_DB=0
# MCP_REDIS_USERNAME=

# ------------------------------------------------------------------------------
# 3. Redis Cluster 分片集群模式开关
# 当配置为 true 时，自动激活 redis.asyncio.cluster.RedisCluster 分片驱动
# 并强制绑定 db=0 与启用跨槽并发删除防御
# ------------------------------------------------------------------------------
MCP_REDIS_CLUSTER=false

# ------------------------------------------------------------------------------
# 4. 多实例连接档案配置文件路径
# 支持 YAML 或 JSON 格式，详见 connections.example.yaml
# ------------------------------------------------------------------------------
# MCP_REDIS_CONFIG=connections.example.yaml

# ------------------------------------------------------------------------------
# 5. 生产级双重写安全门禁 (Write Permission Gate)
# 默认全局强只读 (false)。只有显式设为 true 时，才允许执行 SET/DEL/EXPIRE 等写操作
# ------------------------------------------------------------------------------
MCP_REDIS_ALLOW_WRITE=false
# MCP_REDIS_READ_ONLY=true

# ------------------------------------------------------------------------------
# 6. 全模传输网关与 HTTP 安全配置 (Multi-Transport Gateway & Security)
# - transport: stdio (默认标准管道交互，兼容 Claude Desktop/Cursor)
#              sse (HTTP Server-Sent Events 服务端，监听 /sse 与 /messages/)
#              streamable-http (现代化流式 HTTP 传输协议，监听 /mcp)
# - auth_token: HTTP 传输层轻量访问鉴权凭据 (Bearer Token 与 ?token= 传参，豁免 /health*)
# - allowed_hosts: HTTP 允许的主机标头白名单 (逗号分隔，防御 DNS 重绑定与未授权跨源调用)
# ------------------------------------------------------------------------------
MCP_REDIS_TRANSPORT=stdio
MCP_REDIS_SERVER_HOST=127.0.0.1
MCP_REDIS_SERVER_PORT=8000
# MCP_REDIS_AUTH_TOKEN=YOUR_SECRET_TOKEN
# MCP_REDIS_ALLOWED_HOSTS=mcp.example.com,mcp.internal.net

# ------------------------------------------------------------------------------
# 7. 跨服务身份标识与大模型指导指令 (Server Identification & Instructions)
# 供多 MCP 服务共存时大模型准确识别当前服务身份及业务边界
# ------------------------------------------------------------------------------
# MCP_REDIS_SERVER_NAME=mcp-server-redis
# MCP_REDIS_SERVER_INSTRUCTIONS="专为生产环境打造的 Redis MCP 网关，严格遵循只读与切片原则"

# ------------------------------------------------------------------------------
# 8. 审计日志与 BigKey 内存防爆 (Audit Trail & BigKey Defense)
# - AUDIT_LOG: 'stderr', 'stdout' 或本地文件路径 (stdio 模式下自动隔离重定向至 stderr)
# - MAX_UNBOUNDED_READ_ITEMS: HGETALL/SMEMBERS 等无界读取源头拦截阈值 (默认 2000 项)
# ------------------------------------------------------------------------------
# MCP_REDIS_AUDIT_LOG=stderr
MCP_REDIS_MAX_UNBOUNDED_READ_ITEMS=2000

# ------------------------------------------------------------------------------
# 9. 运行时日志级别 (Logging Level)
# 可选值: DEBUG, INFO, WARNING, ERROR (默认: INFO)
# 日志严格输出至 sys.stderr，绝不污染 Stdio 协议通道
# ------------------------------------------------------------------------------
MCP_REDIS_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 10. 生产级网络超时与连接池上限 (单位: 秒)
# ------------------------------------------------------------------------------
MCP_REDIS_SOCKET_TIMEOUT=10.0
MCP_REDIS_SOCKET_CONNECT_TIMEOUT=5.0
MCP_REDIS_MAX_CONNECTIONS=50
